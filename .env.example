# ==============================================================================
# EchoRoom Environment Variables Reference
# ==============================================================================

# Backend Service
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/echoroom?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_a_secure_random_64_character_hex_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-echoroom-frontend.vercel.app

# Frontend Service
VITE_API_URL=https://your-echoroom-backend.onrender.com/api
VITE_SOCKET_URL=https://your-echoroom-backend.onrender.com
