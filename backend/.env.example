PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/echoroom?retryWrites=true&w=majority

# Mandatory JWT signing secret.
# In production, weak, short (<32 chars), or placeholder secrets are strictly rejected at startup.
# Generate a cryptographically secure 64-character hex secret in Windows PowerShell:
#   $bytes = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); -join ($bytes | ForEach-Object { '{0:x2}' -f $_ })
# Or using Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG

JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
